# %ECSV 0.9
# ---
# datatype:
# - name: HR
#   datatype: int16
#   description: '[1/9110]+ Harvard Revised Number = Bright Star Number'
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {width: 4}
# - name: Name
#   datatype: string
#   description: Name, generally Bayer and/or Flamsteed name
#   meta: !!omap
#   - {ucd: ID_ALTERNATIVE}
#   - {_votable_string_dtype: char}
# - name: HD
#   datatype: int32
#   description: '[1/225300]? Henry Draper Catalog Number'
#   meta: !!omap
#   - {ucd: ID_ALTERNATIVE}
#   - {width: 6}
# - name: ADS
#   datatype: string
#   description: Aitken's Double Star Catalog (ADS) designation
#   meta: !!omap
#   - {ucd: ID_ALTERNATIVE}
#   - {_votable_string_dtype: char}
# - name: VarID
#   datatype: string
#   description: Variable star identification
#   meta: !!omap
#   - {ucd: ID_VARIAB}
#   - {_votable_string_dtype: char}
# - name: RAJ2000
#   unit: '"h:m:s"'
#   datatype: string
#   description: ?Hours RA, equinox J2000, epoch 2000.0 (1)
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
#   - {_votable_string_dtype: char}
# - name: DEJ2000
#   unit: '"d:m:s"'
#   datatype: string
#   description: ?Sign Dec, equinox J2000, epoch 2000.0 (1)
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
#   - values: {'null': ' '}
#   - {_votable_string_dtype: char}
# - name: Vmag
#   unit: mag
#   datatype: float32
#   format: '{:5.2f}'
#   description: ?Visual magnitude (1)
#   meta: !!omap
#   - {ucd: PHOT_JHN_V}
#   - {width: 5}
#   - {precision: '2'}
# - name: B-V
#   unit: mag
#   datatype: float32
#   format: '{:5.2f}'
#   description: '? B-V color in the UBV system'
#   meta: !!omap
#   - {ucd: PHOT_JHN_B-V}
#   - {width: 5}
#   - {precision: '2'}
# - name: SpType
#   datatype: string
#   description: Spectral type
#   meta: !!omap
#   - {ucd: SPECT_TYPE_GENERAL}
#   - {_votable_string_dtype: char}
# - name: NoteFlag
#   datatype: string
#   description: '[*] a star indicates that there is a note (see file notes)'
#   meta: !!omap
#   - {ucd: REMARKS}
#   - {_votable_string_dtype: char}
# - name: Bmag
#   datatype: float32
#   meta: !!omap
#   - {ucd: PHOT_JHN_V}
#   - {width: 5}
#   - {precision: '2'}
# meta: {ID: V_50_catalog, description: The main part of the Catalogue, name: V/50/catalog}
# schema: astropy-2.0
HR Name HD ADS VarID RAJ2000 DEJ2000 Vmag B-V SpType NoteFlag Bmag
