# %ECSV 0.9
# ---
# datatype:
# - name: ID1
#   datatype: string
#   description: Normalised star name (preferably HD) (ID1)
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {_votable_string_dtype: char}
# - name: ID2
#   datatype: string
#   description: Name used in the original publication (ID2) (1)
#   meta: !!omap
#   - {ucd: ID_ALTERNATIVE}
#   - {_votable_string_dtype: char}
# - name: UDdiam
#   unit: mas
#   datatype: float64
#   format: '{:10.5f}'
#   description: '? Uniform Disk Diameter (UD_MEAS)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '5'}
#   - values: {'null': .nan}
# - name: LDdiam
#   unit: mas
#   datatype: float64
#   format: '{:8.4f}'
#   description: '? Limb-Darkened Disk diameter (LD_MEAS)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 8}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: e_LDdiam
#   unit: mas
#   datatype: float64
#   format: '{:9.4f}'
#   description: '? Error on UDdiam and LDdiam (E_LD_MEAS) (2)'
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 9}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: Band
#   datatype: string
#   description: Text describing the wavelength or band of the measurement (BAND) (3)
#   meta: !!omap
#   - {ucd: OBS_BAND}
#   - {_votable_string_dtype: char}
# - name: mu-lambda
#   datatype: float64
#   format: '{:8.5f}'
#   description: '? When possible, value of the conversion UDD-to-LDD user by the author (ORIG_MU_LAMBDA)'
#   meta: !!omap
#   - {ucd: OBS_CALIB_FACTOR}
#   - {width: 8}
#   - {precision: '5'}
#   - values: {'null': .nan}
# - name: Method
#   datatype: uint8
#   description: Integer code of the method used (METHOD) (4)
#   meta: !!omap
#   - {ucd: OBS_METHOD}
#   - {width: 1}
# - name: BandCode
#   datatype: int16
#   description: '? Integer code of the band used (BANDCODE) (5) [NULL integer written as an empty string]'
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {width: 2}
#   - values: {'null': -32768}
# - name: Notes
#   datatype: string
#   description: Note about the star and/or measurement (NOTES)
#   meta: !!omap
#   - {ucd: NOTE}
#   - {_votable_string_dtype: char}
# - name: BibCode
#   datatype: string
#   description: BibCode
#   meta: !!omap
#   - {ucd: REFER_BIBCODE}
#   - {_votable_string_dtype: char}
# - name: SINPE
#   datatype: uint8
#   description: '[0/1] SINPE code (Simbad Identification Not Precise Enough)(6)'
#   meta: !!omap
#   - {ucd: OBSTY_CODE}
#   - {width: 1}
# - name: CADARS
#   datatype: int16
#   description: Display the CADARS (Pasinetti-Fracassini et al., 2001, Cat. II/224) data [NULL integer written as an empty string]
#   meta: !!omap
#   - {ucd: DATA_LINK}
#   - {width: 3}
#   - values: {'null': -32768}
# - name: SimbadName
#   datatype: string
#   description: Simbad column added by the CDS
#   meta: !!omap
#   - {ucd: ID_ALTERNATIVE}
#   - {_votable_string_dtype: char}
# - name: _RA
#   unit: deg
#   datatype: float64
#   format: '{:9.5f}'
#   description: Right Ascension (J2000) from SIMBAD (not part of the original data)
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
#   - {width: 9}
#   - {precision: '5'}
# - name: _DE
#   unit: deg
#   datatype: float64
#   format: '{:9.5f}'
#   description: Declination (J2000) from SIMBAD (not part of the original data)
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
#   - {width: 9}
#   - {precision: '5'}
# meta: {ID: II_345_jmdc, description: 'JMMC Measured stellar Diameters Catalog (as part of Chelli et al., 2016A&A...589A.112C)', name: II/345/jmdc}
# schema: astropy-2.0
ID1 ID2 UDdiam LDdiam e_LDdiam Band mu-lambda Method BandCode Notes BibCode SINPE CADARS SimbadName _RA _DE
