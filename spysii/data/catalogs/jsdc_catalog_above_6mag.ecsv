# %ECSV 0.9
# ---
# datatype:
# - name: Dis
#   datatype: int16
#   description: indicates differences between JSDC V1 and V2 [NULL integer written as an empty string]
#   meta: !!omap
#   - {ucd: POS_ANG_DIST_GENERAL}
#   - {width: 3}
#   - values: {'null': -32768}
# - name: Name
#   datatype: string
#   description: Normalised star name (preferably HD)
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {_votable_string_dtype: char}
# - name: SpType
#   datatype: string
#   description: Spectral Type from Simbad
#   meta: !!omap
#   - {ucd: SPECT_TYPE_MK}
#   - {_votable_string_dtype: char}
# - name: Bmag
#   unit: mag
#   datatype: float32
#   format: '{:7.3f}'
#   description: '? B magnitude (Cat. I/259)'
#   meta: !!omap
#   - {ucd: PHOT_TYCHO_B}
#   - {width: 7}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Vmag
#   unit: mag
#   datatype: float32
#   format: '{:7.3f}'
#   description: '? V magnitude (Cat. I/259)'
#   meta: !!omap
#   - {ucd: PHOT_TYCHO_V}
#   - {width: 7}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Rmag
#   unit: mag
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? R magnitude (estimated)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_R}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: Imag
#   unit: mag
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? I magnitude (estimated)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_I}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: Jmag
#   unit: mag
#   datatype: float32
#   format: '{:7.3f}'
#   description: '? J magnitude (Cat. II/246)'
#   meta: !!omap
#   - {ucd: PHOT_JHN_J}
#   - {width: 7}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Hmag
#   unit: mag
#   datatype: float32
#   format: '{:7.3f}'
#   description: '? H magnitude (Cat. II/246)'
#   meta: !!omap
#   - {ucd: PHOT_JHN_H}
#   - {width: 7}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Kmag
#   unit: mag
#   datatype: float32
#   format: '{:7.3f}'
#   description: '? K magnitude (Cat. II/246)'
#   meta: !!omap
#   - {ucd: PHOT_JHN_K}
#   - {width: 7}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Lmag
#   unit: mag
#   datatype: float32
#   format: '{:7.3f}'
#   description: '? L magnitude (Cat. II/311/wise W1mag)'
#   meta: !!omap
#   - {ucd: PHOT_JHN_L}
#   - {width: 7}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Mmag
#   unit: mag
#   datatype: float32
#   format: '{:6.3f}'
#   description: '? M magnitude (Cat. II/311/wise W2mag)'
#   meta: !!omap
#   - {ucd: PHOT_JHN_M}
#   - {width: 6}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Nmag
#   unit: mag
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? N magnitude (Cat. II/311/wise W3mag)'
#   meta: !!omap
#   - {ucd: 'PHOT_IR_N:10.4'}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: LDD
#   unit: mas
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Limb-Darkened Disk diameter'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: e_LDD
#   unit: mas
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Error on LDD (and all UDDs) (1)'
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: LDDCHI
#   datatype: float64
#   format: '{:12.5g}'
#   description: Chi2 of LDD fitting (2)
#   meta: !!omap
#   - {ucd: FIT_CHI2}
#   - {width: 12}
#   - {precision: E5}
# - name: CalFlag
#   datatype: uint8
#   description: '[0/7] Confidence flags for using this star as a calibrator in Optical Interferometry experiments (3)'
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {width: 1}
# - name: UDDB
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Uniform Disk Diameter in band B (4)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: UDDV
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Uniform Disk Diameter in band V (4)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: UDDR
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Uniform Disk Diameter in band R (4)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: UDDI
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Uniform Disk Diameter in band I (4)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: UDDJ
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Uniform Disk Diameter in band J (4)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: UDDH
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Uniform Disk Diameter in band H (4)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: UDDK
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Uniform Disk Diameter in band K (4)'
#   meta: !!omap
#   - {ucd: EXTENSION_DIAM}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: UDDL
